@page "/trades"
@rendermode InteractiveServer
@using TradingTools.Blazor.Services.AddOns
@using TradingTools.Blazor.Services.Dashboard
@using TradingTools.Blazor.Services.Reviews

<MudProviders />

<PageTitle>Trades</PageTitle>

<div class="app-content">

<TopBar Title="Trades" />

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Success" />
}
else if (_vm is null || CurrentTradeObj is null)
{
    <div class="app-card" style="padding:48px; text-align:center;">
        <MudText Typo="Typo.h6">No trades yet</MudText>
        <MudText Typo="Typo.body2" Style="color:var(--app-text-secondary); margin-top:6px;">Log your first trade to see it here.</MudText>
    </div>
}
else
{
    <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px;">
        <div style="display:flex; align-items:center; gap:16px; flex-wrap:wrap;">
            <div style="display:flex; flex-direction:column; gap:3px;">
                <span style="font-size:10px; font-weight:700; color:var(--app-text-secondary); letter-spacing:.04em;">TRADE</span>
                <div class="app-nav-counter">
                    <button @onclick="PrevTrade" disabled="@(_tradeIndex <= 0)"><MudIcon Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small" /></button>
                    <span class="app-nav-counter-value">@(_tradeIndex + 1) / @_vm.AllTradesInSampleSize.Count</span>
                    <button @onclick="NextTrade" disabled="@(_tradeIndex >= _vm.AllTradesInSampleSize.Count - 1)"><MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" /></button>
                </div>
            </div>
            <div style="display:flex; flex-direction:column; gap:3px;">
                <span style="font-size:10px; font-weight:700; color:var(--app-text-secondary); letter-spacing:.04em;">SAMPLE SIZE</span>
                <div class="app-nav-counter">
                    <button @onclick="PrevSampleSize" disabled="@(!CanGoPrevSampleSize)"><MudIcon Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small" /></button>
                    <span class="app-nav-counter-value">@(SampleSizePosition + 1) / @_vm.SampleSizes.Count</span>
                    <button @onclick="NextSampleSize" disabled="@(!CanGoNextSampleSize)"><MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" /></button>
                </div>
            </div>
            <MudText Typo="Typo.body2" Style="color:var(--app-text-secondary);">@CurrentBase!.Date.ToString("MMM d, yyyy")</MudText>
        </div>

        <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
            <MudSelect T="Strategy" Value="_vm.CurrentSampleSize.Strategy" ValueChanged="ChangeStrategy" Dense="true" Variant="Variant.Outlined" Style="min-width:160px;">
                @foreach (var s in _vm.AvailableStrategies)
                {
                    <MudSelectItem Value="@s">Strategy: @MyEnumConverter.StrategyFromEnum(s)</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="SampleSizeType" Value="_vm.CurrentSampleSize.SampleSizeType" ValueChanged="ChangeType" Dense="true" Variant="Variant.Outlined" Style="min-width:150px;">
                <MudSelectItem Value="SampleSizeType.Trade">Type: Trade</MudSelectItem>
                <MudSelectItem Value="SampleSizeType.DemoTrading">Type: Demo Trading</MudSelectItem>
                <MudSelectItem Value="SampleSizeType.PaperTrade">Type: Paper Trade</MudSelectItem>
            </MudSelect>
            <MudSelect T="TimeFrame" Value="_vm.CurrentSampleSize.TimeFrame" ValueChanged="ChangeTimeFrame" Dense="true" Variant="Variant.Outlined" Style="min-width:140px;">
                @foreach (var tf in _vm.AvailableTimeframes)
                {
                    <MudSelectItem Value="@tf">Timeframe: @MyEnumConverter.TimeFrameFromEnum(tf)</MudSelectItem>
                }
            </MudSelect>
        </div>
    </div>

    <div style="display:flex; flex-direction:column; gap:20px;">

        <div class="app-card" style="width:100%; padding:16px; display:flex; flex-direction:column; gap:12px;">
            @if (CurrentBase!.ScreenshotsUrls is { Count: > 0 } urls)
            {
                @* The whole screenshot is always shown, never cropped: it fills the width at its own proportions,
                   and is scaled down (contain) when that would be taller than 78% of the window. A fixed-size box
                   with object-fit:cover cropped it whenever the window's shape differed from the screenshot's. *@
                @* data-fullscreen: the whole box (image, buttons, counter) goes full screen (wwwroot/js/fullscreen.js), so
                   the previous/next buttons - Blazor handlers - stay clickable, and the arrow keys press them. *@
                <div class="app-carousel" data-fullscreen>
                    <img class="app-carousel-img" src="@("/" + urls[_screenshotIndex])" alt="Screenshot @(_screenshotIndex + 1) of @urls.Count" />
                    <button type="button" class="app-carousel-btn app-carousel-fs" onclick="appFullscreen.toggle(this)" title="Full screen (Esc to close)" aria-label="Toggle full screen">
                        <svg class="app-fs-enter" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" /></svg>
                        <svg class="app-fs-exit" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 4v5H4M15 4v5h5M9 20v-5H4M15 20v-5h5" /></svg>
                    </button>
                    @if (urls.Count > 1)
                    {
                        <button class="app-carousel-btn" style="left:14px;" data-fullscreen-prev aria-label="Previous screenshot" @onclick="PrevScreenshot"><MudIcon Icon="@Icons.Material.Filled.ChevronLeft" /></button>
                        <button class="app-carousel-btn" style="right:14px;" data-fullscreen-next aria-label="Next screenshot" @onclick="NextScreenshot"><MudIcon Icon="@Icons.Material.Filled.ChevronRight" /></button>
                        <div style="position:absolute; bottom:10px; left:0; right:0; text-align:center; color:white; font-size:11px; text-shadow:0 1px 2px black;">@(_screenshotIndex + 1) / @urls.Count</div>
                    }
                </div>
            }
            else
            {
                <div style="padding:48px; text-align:center; color:var(--app-text-secondary);">No screenshots for this trade.</div>
            }
        </div>

        <div class="app-card" style="width:100%; display:flex; flex-direction:column;">
            @if (CurrentIssues is { Count: > 0 } issues)
            {
                @* The most recent trade may still be in progress, so its gaps are informational only. *@
                <MudAlert Severity="@(CurrentIsMostRecentTrade ? Severity.Info : Severity.Warning)" Variant="Variant.Outlined" Dense="true" Class="ma-4 mb-0">
                    <div style="font-weight:700; margin-bottom:4px;">
                        @(CurrentIsMostRecentTrade
                            ? "Most recent trade - still to be completed:"
                            : $"This trade has {issues.Count} problem{(issues.Count == 1 ? "" : "s")}:")
                    </div>
                    <ul style="margin:0; padding-left:18px;">
                        @foreach (var issue in issues)
                        {
                            <li>@issue.Message</li>
                        }
                    </ul>
                </MudAlert>
            }
            <MudTabs @bind-ActivePanelIndex="_activeTab" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pa-4">
                <MudTabPanel Text="Trade Data">
                    <MudText Typo="Typo.overline" Class="mb-2" Style="color:var(--app-text-secondary);">Basic info</MudText>
                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6" md="4"><MudDatePicker Culture="AppCulture.DatePicker" Margin="Margin.Dense" Label="Date" Date="CurrentBase.Date.ToDateTime(TimeOnly.MinValue)" DateChanged="@(d => CurrentBase.Date = DateOnly.FromDateTime(d ?? DateTime.Now))" Variant="Variant.Outlined" /></MudItem>
                        <MudItem xs="12" sm="6" md="4">
                            <MudSelect Margin="Margin.Dense" T="ESymbol?" @bind-Value="CurrentSymbol" Label="Symbol" Variant="Variant.Outlined"
                                       Error="@(IssueFor(nameof(BaseTrade.Symbol)) is not null)" ErrorText="@IssueFor(nameof(BaseTrade.Symbol))">
                                @foreach (var s in Enum.GetValues<ESymbol>())
                                {
                                    <MudSelectItem T="ESymbol?" Value="@s">@MyEnumConverter.SymbolFromEnum(s)</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="4">
                            <MudSelect Margin="Margin.Dense" T="EDirection" @bind-Value="CurrentBase.Direction" @bind-Value:after="RecalculateOutcome" Label="Direction" Variant="Variant.Outlined">
                                <MudSelectItem Value="EDirection.Long">Long</MudSelectItem>
                                <MudSelectItem Value="EDirection.Short">Short</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="4"><MudNumericField Margin="Margin.Dense" T="double?" @bind-Value="CurrentBase.Amount" @bind-Value:after="RecalculateOutcome" Label="Amount" Variant="Variant.Outlined"
                                                                         Error="@(IssueFor(nameof(BaseTrade.Amount)) is not null)" ErrorText="@IssueFor(nameof(BaseTrade.Amount))" /></MudItem>
                        <MudItem xs="12" sm="6" md="4">
                            <MudSelect Margin="Margin.Dense" T="EOutcome" @bind-Value="CurrentBase.Outcome" Label="Outcome" Variant="Variant.Outlined"
                                       Error="@(IssueFor(nameof(BaseTrade.Outcome)) is not null)" ErrorText="@IssueFor(nameof(BaseTrade.Outcome))">
                                @foreach (var o in Enum.GetValues<EOutcome>())
                                {
                                    <MudSelectItem Value="@o">@o</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="4">
                            <MudSelect Margin="Margin.Dense" T="ETradeRating" @bind-Value="CurrentBase.TradeRating" Label="Rating" Variant="Variant.Outlined">
                                <MudSelectItem Value="ETradeRating.APlus">A+</MudSelectItem>
                                <MudSelectItem Value="ETradeRating.A">A</MudSelectItem>
                                <MudSelectItem Value="ETradeRating.AMinus">A-</MudSelectItem>
                                <MudSelectItem Value="ETradeRating.BookOfHorror">Book of Horror</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                    </MudGrid>
                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.overline" Class="mb-2" Style="color:var(--app-text-secondary);">Prices</MudText>
                    <MudGrid Spacing="2">
                        @* Entry and exit recalculate the P&L as they're typed. *@
                        <MudItem xs="12" sm="6" md="3"><MudNumericField Margin="Margin.Dense" T="double?" Value="CurrentBase.EntryPrice" ValueChanged="OnEntryPriceChanged" Immediate="true" Label="Entry Price" Variant="Variant.Outlined" Format="F2"
                                                                         Error="@(IssueFor(nameof(BaseTrade.EntryPrice)) is not null)" ErrorText="@IssueFor(nameof(BaseTrade.EntryPrice))" /></MudItem>
                        <MudItem xs="12" sm="6" md="3"><MudNumericField Margin="Margin.Dense" T="double?" @bind-Value="CurrentBase.StopPrice" Label="Stop Price" Variant="Variant.Outlined" Format="F2"
                                                                         Error="@(IssueFor(nameof(BaseTrade.StopPrice)) is not null)" ErrorText="@IssueFor(nameof(BaseTrade.StopPrice))" /></MudItem>
                        <MudItem xs="12" sm="6" md="3"><MudNumericField Margin="Margin.Dense" T="double?" Value="CurrentBase.ExitPrice" ValueChanged="OnExitPriceChanged" Immediate="true" Label="Exit Price" Variant="Variant.Outlined" Format="F2"
                                                                         Error="@(IssueFor(nameof(BaseTrade.ExitPrice)) is not null)" ErrorText="@IssueFor(nameof(BaseTrade.ExitPrice))" /></MudItem>
                        <MudItem xs="12" sm="6" md="3"><MudNumericField Margin="Margin.Dense" T="double?" @bind-Value="CurrentBase.MaxPrice" Label="Max Price" Variant="Variant.Outlined" Format="F2"
                                                                         Error="@(IssueFor(nameof(BaseTrade.MaxPrice)) is not null)" ErrorText="@IssueFor(nameof(BaseTrade.MaxPrice))" /></MudItem>
                    </MudGrid>
                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.overline" Class="mb-2" Style="color:var(--app-text-secondary);">Results</MudText>
                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6" md="3">
                            <MudNumericField Margin="Margin.Dense" T="double?" @bind-Value="CurrentBase.PnL" Label="P&amp;L (points)" Variant="Variant.Outlined" Format="F2"
                                             HelperText="Filled in from |exit − entry|"
                                             Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Calculate" AdornmentAriaLabel="Recalculate from entry and exit" OnAdornmentClick="RecalculatePnl"
                                             Error="@(IssueFor(nameof(BaseTrade.PnL)) is not null)" ErrorText="@IssueFor(nameof(BaseTrade.PnL))" />
                        </MudItem>
                    </MudGrid>
                    @* The same calculation as the dashboard and the history: spread taken off every position. *@
                    <div class="app-addon-net">
                        @if (CurrentResult is { Euro: { } resultEuro } result)
                        {
                            <span>Result after spread</span>
                            <span class="app-mono @DashboardFormat.ToneClass(resultEuro)">@DashboardFormat.SignedEuro(resultEuro)</span>
                            @if (result.Points is { } resultPoints)
                            {
                                <span class="app-mono @DashboardFormat.ToneClass(resultPoints)">@DashboardFormat.SignedPoints(resultPoints)</span>
                            }
                            <span class="app-addon-net-parts">
                                @if (CurrentSpread > 0)
                                {
                                    <span>spread @DashboardFormat.Number(CurrentSpread) pts per position, @DashboardFormat.SignedEuro(-result.SpreadEuro) in total</span>
                                }
                                else
                                {
                                    <span>no spread set for @(string.IsNullOrWhiteSpace(CurrentBase.Symbol) ? "this instrument" : CurrentBase.Symbol) - see Settings</span>
                                }
                            </span>
                        }
                        else
                        {
                            <span>Result after spread: fill in the outcome, the P&amp;L and the amount to see it.</span>
                        }
                    </div>
                    <MudDivider Class="my-3" />
                    <div style="display:flex; align-items:center; justify-content:space-between;" class="mb-2">
                        <MudText Typo="Typo.overline" Style="color:var(--app-text-secondary);">Add-ons</MudText>
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddAddOn">Add add-on</MudButton>
                    </div>
                    @if (CurrentBase.AddOns.Count == 0)
                    {
                        <MudText Typo="Typo.caption" Style="color:var(--app-text-secondary);">No add-ons. Add one for each time you added to the position while the trade was open.</MudText>
                    }
                    @* A for loop with a copied index: each row's field names ("AddOns[1].ExitPrice") come from its position. *@
                    @for (int i = 0; i < CurrentBase.AddOns.Count; i++)
                    {
                        int index = i;
                        var addOn = CurrentBase.AddOns[index];
                        <div class="app-addon-row" @key="addOn">
                            <div class="app-addon-number">#@(index + 1)</div>
                            <MudNumericField Margin="Margin.Dense" T="double?" Value="addOn.EntryPrice" ValueChanged="@(v => OnAddOnEntryChanged(addOn, v))" Immediate="true" Label="Entry Price" Variant="Variant.Outlined" Format="F2"
                                             Error="@(AddOnIssue(index, nameof(TradeAddOn.EntryPrice)) is not null)" ErrorText="@AddOnIssue(index, nameof(TradeAddOn.EntryPrice))" />
                            <MudNumericField Margin="Margin.Dense" T="double?" Value="addOn.ExitPrice" ValueChanged="@(v => OnAddOnExitChanged(addOn, v))" Immediate="true" Label="Exit Price" Variant="Variant.Outlined" Format="F2"
                                             Error="@(AddOnIssue(index, nameof(TradeAddOn.ExitPrice)) is not null)" ErrorText="@AddOnIssue(index, nameof(TradeAddOn.ExitPrice))" />
                            <MudNumericField Margin="Margin.Dense" T="double?" @bind-Value="addOn.Volume" @bind-Value:after="RecalculateOutcome" Label="Volume" Variant="Variant.Outlined"
                                             Error="@(AddOnIssue(index, nameof(TradeAddOn.Volume)) is not null)" ErrorText="@AddOnIssue(index, nameof(TradeAddOn.Volume))" />
                            <MudNumericField Margin="Margin.Dense" T="double?" @bind-Value="addOn.PnL" Label="P&amp;L (points)" Variant="Variant.Outlined" Format="F2"
                                             Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Calculate" AdornmentAriaLabel="Recalculate from entry and exit" OnAdornmentClick="@(() => RecalculateAddOnPnl(addOn))"
                                             Error="@(AddOnIssue(index, nameof(TradeAddOn.PnL)) is not null)" ErrorText="@AddOnIssue(index, nameof(TradeAddOn.PnL))" />
                            <AddOnOutcome Dense="true" Outcome="@TradeAddOns.OutcomeOf(addOn, CurrentBase.Direction)" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" aria-label="Remove add-on" Style="margin-top:6px;" OnClick="@(() => RemoveAddOn(addOn))" />
                        </div>
                    }
                    @if (CurrentBase.AddOns.Count > 0)
                    {
                        @* One trade, one result: the outcome follows the net of the main position and every add-on. *@
                        <div class="app-addon-net">
                            @if (CurrentNet is { } net)
                            {
                                <span>Net result after spread</span>
                                <span class="app-mono @DashboardFormat.ToneClass(net.NetEuro)">@DashboardFormat.SignedEuro(net.NetEuro)</span>
                                <span>&rarr; <strong>@net.Outcome</strong></span>
                                <span class="app-addon-net-parts">main <span class="app-mono">@DashboardFormat.SignedEuro(net.MainEuro)</span> · add-ons <span class="app-mono">@DashboardFormat.SignedEuro(net.AddOnsEuro)</span></span>
                            }
                            else
                            {
                                <span>Net result of the whole trade: fill in the amount, direction and every price and volume to see it.</span>
                            }
                        </div>
                        <MudText Typo="Typo.caption" Style="color:var(--app-text-secondary);">The outcome is set from the net result. Add-ons are saved with the Update button, together with the rest of the trade data.</MudText>
                    }
                </MudTabPanel>

                <MudTabPanel Text="Research">
                    <MudGrid Spacing="3">
                        @if (AsSRS is not null)
                        {
                            <MudItem xs="12" sm="6" md="4">
                                <MudSelect T="ECandleType" @bind-Value="AsSRS.CandleType" Label="Candle Type" Variant="Variant.Outlined">
                                    @foreach (var c in Enum.GetValues<ECandleType>())
                                    {
                                        <MudSelectItem Value="@c">@c</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" sm="6" md="4" Style="display:flex; align-items:center;"><MudSwitch T="bool" @bind-Value="AsSRS.IsInOverNightRange" Label="In overnight range" Color="Color.Success" /></MudItem>
                            <MudItem xs="12" sm="6" md="4" Style="display:flex; align-items:center;"><MudSwitch T="bool" @bind-Value="AsSRS.IsFlippedTheSwitch" Label="Flipped the switch" Color="Color.Success" /></MudItem>
                        }
                        else if (AsBrunchBreak is not null)
                        {
                            <MudItem xs="12" sm="6" md="4">
                                <MudSelect T="ECandleType" @bind-Value="AsBrunchBreak.CandleType" Label="Candle Type" Variant="Variant.Outlined">
                                    @foreach (var c in Enum.GetValues<ECandleType>())
                                    {
                                        <MudSelectItem Value="@c">@c</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" sm="6" md="4" Style="display:flex; align-items:center;"><MudSwitch T="bool" @bind-Value="AsBrunchBreak.IsFlippedTheSwitch" Label="Flipped the switch" Color="Color.Success" /></MudItem>
                        }
                        else if (AsEspresso is not null)
                        {
                            <MudItem xs="12" sm="6" md="4">
                                <MudSelect T="ECandleType" @bind-Value="AsEspresso.CandleType" Label="Candle Type" Variant="Variant.Outlined">
                                    @foreach (var c in Enum.GetValues<ECandleType>())
                                    {
                                        <MudSelectItem Value="@c">@c</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" sm="6" md="4" Style="display:flex; align-items:center;"><MudSwitch T="bool" @bind-Value="AsEspresso.IsInOverNightRange" Label="In overnight range" Color="Color.Success" /></MudItem>
                            <MudItem xs="12" sm="6" md="4" Style="display:flex; align-items:center;"><MudSwitch T="bool" @bind-Value="AsEspresso.IsFlippedTheSwitch" Label="Flipped the switch" Color="Color.Success" /></MudItem>
                        }
                    </MudGrid>
                </MudTabPanel>

                <MudTabPanel Text="Journal">
                    @if (CurrentBase.Journal is { } journal)
                    {
                        <MudExpansionPanels MultiExpansion="true" Elevation="0" Class="app-expansion">
                            <MudExpansionPanel Text="Pre"><RichTextEditor @bind-Value="journal.Pre" /></MudExpansionPanel>
                            <MudExpansionPanel Text="During"><RichTextEditor @bind-Value="journal.During" /></MudExpansionPanel>
                            <MudExpansionPanel Text="Exit"><RichTextEditor @bind-Value="journal.Exit" /></MudExpansionPanel>
                            <MudExpansionPanel Text="Post"><RichTextEditor @bind-Value="journal.Post" /></MudExpansionPanel>
                        </MudExpansionPanels>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Style="color:var(--app-text-secondary);">No journal linked to this trade.</MudText>
                    }
                </MudTabPanel>

                @* A blue dot while a review of this sample size is due (it stays due until it has text). *@
                <MudTabPanel Text="Review" BadgeDot="@(_dueReview is { Reviews.Count: > 0 })" BadgeColor="Color.Info" ToolTip="@(_dueReview is { Reviews.Count: > 0 } ? "A review is ready" : null)">
                    @if (_vm.CurrentSampleSize.Review is { } review)
                    {
                        <MudExpansionPanels MultiExpansion="true" Elevation="0" Class="app-expansion">
                            @* A review of every 5 trades, then one for the whole sample size. The one that is to be done is open. *@
                            @foreach (var kind in ReviewSchedule.All)
                            {
                                var current = kind;
                                <MudExpansionPanel Expanded="_openReviews.Contains(current)" ExpandedChanged="@(open => SetReviewOpen(current, open))">
                                    <TitleContent>
                                        <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
                                            <span>@(current == ReviewKind.Summary ? "Summary" : current.ToString())</span>
                                            <span style="font-size:11.5px; color:var(--app-text-secondary);">@ReviewSchedule.Covers(current)</span>
                                            @if (IsDue(current))
                                            {
                                                <span class="app-chip app-chip-green">To do</span>
                                            }
                                        </div>
                                    </TitleContent>
                                    <ChildContent>
                                        <RichTextEditor Value="@ReviewSchedule.TextOf(review, current)" ValueChanged="@(text => ReviewSchedule.SetText(review, current, text))" />
                                    </ChildContent>
                                </MudExpansionPanel>
                            }
                        </MudExpansionPanels>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Style="color:var(--app-text-secondary);">This sample size has no review yet.</MudText>
                    }
                </MudTabPanel>
            </MudTabs>

            <div style="padding:14px 20px 20px; border-top:1px solid var(--app-border); display:flex; gap:8px; flex-wrap:wrap; margin-top:auto;">
                <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Save" OnClick="UpdateAsync" Disabled="_saving">Update</MudButton>

                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Upload" Disabled="_saving" ButtonType="ButtonType.Button" OnClick="TriggerUpload">Upload</MudButton>
                <InputFile id="uploadMoreInput" OnChange="OnUploadMoreScreenshots" multiple accept="image/*" style="display:none;" />

                <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="ConfirmDeleteAsync" Disabled="_saving" Style="margin-left:auto;">Delete</MudButton>
            </div>
        </div>
    </div>
}

</div>
