@page "/new-trade"
@rendermode InteractiveServer
@using TradingTools.Blazor.Services.AddOns
@using TradingTools.Blazor.Services.Dashboard

<MudProviders />

<PageTitle>New Trade</PageTitle>

<div class="app-content" style="align-items:center;">
    <div style="width:100%; max-width:920px; display:flex; flex-direction:column; gap:20px;">

        <TopBar Title="Log a new trade" Subtitle="Capture the setup while it’s fresh. You can fill in the journal later." />

        <div class="app-card" style="padding:24px;">
            <MudText Typo="Typo.subtitle1" Style="font-weight:700; margin-bottom:16px;">Sample</MudText>
            <MudGrid Spacing="3">
                <MudItem xs="12" sm="4">
                    <MudSelect T="Strategy" Value="_sizeData.Strategy" ValueChanged="OnStrategyChanged" Label="Strategy" Variant="Variant.Outlined" Dense="true">
                        <MudSelectItem Value="Strategy.SRS">SRS</MudSelectItem>
                        <MudSelectItem Value="Strategy.Espresso">Espresso</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSelect T="TimeFrame" Value="_sizeData.TimeFrame" ValueChanged="OnTimeFrameChanged" Label="Timeframe" Variant="Variant.Outlined" Dense="true">
                        @foreach (var tf in Enum.GetValues<TimeFrame>())
                        {
                            <MudSelectItem Value="@tf">@MyEnumConverter.TimeFrameFromEnum(tf)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSelect T="SampleSizeType" @bind-Value="_sizeData.SampleSizeType" Label="Type" Variant="Variant.Outlined" Dense="true">
                        <MudSelectItem Value="SampleSizeType.Trade">Trade</MudSelectItem>
                        <MudSelectItem Value="SampleSizeType.DemoTrading">Demo Trading</MudSelectItem>
                    </MudSelect>
                </MudItem>
            </MudGrid>
        </div>

        <div class="app-card" style="padding:24px;">
            <MudText Typo="Typo.subtitle1" Style="font-weight:700; margin-bottom:16px;">Screenshots</MudText>

            <div @onclick="TriggerUpload" style="display:flex; flex-direction:column; align-items:center; justify-content:center; gap:8px; padding:28px; min-height:110px; border:2px dashed var(--app-border); border-radius:12px; cursor:pointer;">
                <MudIcon Icon="@Icons.Material.Filled.UploadFile" Style="color:var(--app-accent);" />
                <span style="font-size:13px; font-weight:600;">Click to browse</span>
                <span style="font-size:11.5px; color:var(--app-text-secondary);">PNG or JPG, up to 10MB each</span>
            </div>
            <InputFile id="screenshotInput" OnChange="OnFilesSelected" multiple accept="image/*" style="display:none;" />

            @if (_uploadedFiles.Count > 0)
            {
                <div style="display:flex; flex-wrap:wrap; gap:8px; margin-top:12px;">
                    @foreach (var file in _uploadedFiles)
                    {
                        <div style="display:flex; align-items:center; gap:8px; background:var(--app-surface-variant); border:1px solid var(--app-border); border-radius:8px; padding:6px 8px 6px 10px;">
                            <span style="font-size:11.5px; color:var(--app-text-secondary);">@file.Name</span>
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@(() => RemoveFile(file))" />
                        </div>
                    }
                </div>
            }
            else
            {
                <MudText Typo="Typo.caption" Style="color:var(--app-text-secondary); margin-top:8px; display:block;">No uploaded files.</MudText>
            }
        </div>

        <div class="app-card" style="padding:8px 24px 24px;">
            <MudTabs Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pa-4">
                <MudTabPanel Text="Basic Info">
                    <MudGrid Spacing="3">
                        <MudItem xs="12" sm="6" md="4">
                            <MudDatePicker Culture="AppCulture.DatePicker" Label="Date" @bind-Date="_dateAsDateTime" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="4">
                            <MudSelect T="ESymbol" @bind-Value="_symbol" @bind-Value:after="OnSymbolChanged" Label="Symbol" Variant="Variant.Outlined">
                                @foreach (var s in Enum.GetValues<ESymbol>())
                                {
                                    <MudSelectItem Value="@s">@MyEnumConverter.SymbolFromEnum(s)</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="4">
                            <MudSelect T="EDirection" @bind-Value="_direction" @bind-Value:after="RecalculateOutcome" Label="Direction" Variant="Variant.Outlined">
                                <MudSelectItem Value="EDirection.Long">Long</MudSelectItem>
                                <MudSelectItem Value="EDirection.Short">Short</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="4">
                            <MudNumericField T="double?" @bind-Value="_amount" @bind-Value:after="RecalculateOutcome" Label="Amount" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="4">
                            @* Read-only, like an add-on's: set from the prices and direction (the net result with add-ons). *@
                            <AddOnOutcome Outcome="DeterminedOutcome"
                                          Hint="@(_addOns.Count > 0 ? "Set automatically from the net result of the main position and its add-ons" : null)" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="4">
                            <MudSelect T="ETradeRating" @bind-Value="_rating" Label="Rating" Variant="Variant.Outlined">
                                <MudSelectItem Value="ETradeRating.APlus">A+</MudSelectItem>
                                <MudSelectItem Value="ETradeRating.A">A</MudSelectItem>
                                <MudSelectItem Value="ETradeRating.AMinus">A-</MudSelectItem>
                                <MudSelectItem Value="ETradeRating.BookOfHorror">Book of Horror</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>

                <MudTabPanel Text="Prices">
                    <MudGrid Spacing="3">
                        <MudItem xs="12" sm="6" md="3">
                            <MudNumericField T="double?" Value="_entryPrice" ValueChanged="OnEntryPriceChanged" Immediate="true" Label="Entry Price" Variant="Variant.Outlined" Format="F2" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudNumericField T="double?" @bind-Value="_stopPrice" Label="Stop Price" Variant="Variant.Outlined" Format="F2" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudNumericField T="double?" Value="_exitPrice" ValueChanged="OnExitPriceChanged" Immediate="true" Label="Exit Price" Variant="Variant.Outlined" Format="F2" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudNumericField T="double?" @bind-Value="_maxPrice" Label="Max Price" Variant="Variant.Outlined" Format="F2" />
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>

                <MudTabPanel Text="Results">
                    <MudGrid Spacing="3">
                        <MudItem xs="12" sm="6" md="4">
                            <MudNumericField T="double?" @bind-Value="_pnl" Label="P&amp;L (points)" HelperText="Filled in from |exit − entry|" Variant="Variant.Outlined" Format="F2" />
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>

                <MudTabPanel Text="@(_addOns.Count == 0 ? "Add-ons" : $"Add-ons ({_addOns.Count})")">
                    <div style="display:flex; align-items:center; justify-content:space-between;" class="mb-3">
                        <MudText Typo="Typo.body2" Style="color:var(--app-text-secondary);">Each time you added to the position while the trade was open. The max price only applies to the original trade.</MudText>
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddAddOn" Style="flex:0 0 auto;">Add add-on</MudButton>
                    </div>
                    @if (_addOns.Count == 0)
                    {
                        <MudText Typo="Typo.caption" Style="color:var(--app-text-secondary);">No add-ons.</MudText>
                    }
                    @for (int i = 0; i < _addOns.Count; i++)
                    {
                        int index = i;
                        var addOn = _addOns[index];
                        <div class="app-addon-row" @key="addOn">
                            <div class="app-addon-number">#@(index + 1)</div>
                            <MudNumericField T="double?" Value="addOn.EntryPrice" ValueChanged="@(v => OnAddOnEntryChanged(addOn, v))" Immediate="true" Label="Entry Price" Variant="Variant.Outlined" Format="F2" />
                            <MudNumericField T="double?" Value="addOn.ExitPrice" ValueChanged="@(v => OnAddOnExitChanged(addOn, v))" Immediate="true" Label="Exit Price" Variant="Variant.Outlined" Format="F2" />
                            <MudNumericField T="double?" @bind-Value="addOn.Volume" @bind-Value:after="RecalculateOutcome" Label="Volume" Variant="Variant.Outlined" />
                            <MudNumericField T="double?" @bind-Value="addOn.PnL" Label="P&amp;L (points)" HelperText="Filled in from |exit − entry|" Variant="Variant.Outlined" Format="F2" />
                            <AddOnOutcome Outcome="@TradeAddOns.OutcomeOf(addOn, _direction)" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" aria-label="Remove add-on" Style="margin-top:10px;" OnClick="@(() => RemoveAddOn(addOn))" />
                        </div>
                    }
                    @if (_addOns.Count > 0)
                    {
                        @* One trade, one result: the Outcome (Basic Info tab) follows the net of the main position and every add-on. *@
                        <div class="app-addon-net">
                            @if (Net is { } net)
                            {
                                <span>Net result after spread</span>
                                <span class="app-mono @DashboardFormat.ToneClass(net.NetEuro)">@DashboardFormat.SignedEuro(net.NetEuro)</span>
                                <span>&rarr; <strong>@net.Outcome</strong></span>
                                <span class="app-addon-net-parts">main <span class="app-mono">@DashboardFormat.SignedEuro(net.MainEuro)</span> · add-ons <span class="app-mono">@DashboardFormat.SignedEuro(net.AddOnsEuro)</span></span>
                            }
                            else
                            {
                                <span>Net result of the whole trade: fill in the amount, direction and every price and volume to see it.</span>
                            }
                        </div>
                        <MudText Typo="Typo.caption" Style="color:var(--app-text-secondary);">The outcome is set from the net result.</MudText>
                    }
                </MudTabPanel>

                <MudTabPanel Text="Strategy">
                    <MudGrid Spacing="3">
                        <MudItem xs="12" sm="6" md="4">
                            <MudSelect T="ECandleType" @bind-Value="_candleType" Label="Candle Type" Variant="Variant.Outlined">
                                @foreach (var c in Enum.GetValues<ECandleType>())
                                {
                                    <MudSelectItem Value="@c">@c</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        @if (_sizeData.Strategy is Strategy.SRS or Strategy.Espresso)
                        {
                            <MudItem xs="12" sm="6" md="4" Style="display:flex; align-items:center;">
                                <MudSwitch T="bool" @bind-Value="_isInOvernightRange" Label="In overnight range" Color="Color.Success" />
                            </MudItem>
                        }
                        <MudItem xs="12" sm="6" md="4" Style="display:flex; align-items:center;">
                            <MudSwitch T="bool" @bind-Value="_isFlippedSwitch" Label="Flipped the switch" Color="Color.Success" />
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>
            </MudTabs>
        </div>

        <div style="display:flex; justify-content:flex-end; gap:10px;">
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="ClearForm" Disabled="_saving">Clear</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveAsync" Disabled="_saving">
                @(_saving ? "Saving..." : "Save Trade")
            </MudButton>
        </div>

    </div>
</div>
