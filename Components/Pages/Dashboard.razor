@page "/"
@rendermode InteractiveServer
@using TradingTools.Blazor.Services.Dashboard

<MudProviders />

<PageTitle>Dashboard</PageTitle>

<div class="app-content">

    <TopBar Title="Dashboard" Subtitle="@($"{DashboardSelection.StrategyLabel(_strategy)} · {DateTime.Now.ToString("dddd, MMMM d", System.Globalization.CultureInfo.InvariantCulture)}")">
        <TradeSelectionSwitch @bind-SelectedStrategy="_strategy" @bind-SelectedStrategy:after="RefreshAsync"
                              @bind-SelectedAccount="_account" @bind-SelectedAccount:after="RefreshAsync" />
    </TopBar>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_summary is null || _accountTrades.Count == 0)
    {
        <div class="app-card" style="padding:48px; text-align:center;">
            <MudText Typo="Typo.h6">No trades yet</MudText>
            <MudText Typo="Typo.body2" Style="color:var(--app-text-secondary); margin-top:6px;">
                Closed @DashboardSelection.StrategyLabel(_strategy) trades on the @MyEnumConverter.TradeTypeFromEnum(_account) account will show up here.
            </MudText>
        </div>
    }
    else
    {
        var s = _summary;
        var streak = s.CurrentStreak;

        @* Gain figures on the left, their loss counterparts mirrored on the right, win rate in the centre. *@
        <section class="app-ledger" aria-label="Key figures">
            <div class="app-ledger-side left">
                <div class="app-ledger-cell">
                    <span class="app-label">Best streak</span>
                    <span class="app-ledger-value app-gain">@(s.BestWinStreak)W</span>
                    <span class="app-ledger-sub">wins in a row · BE ignored</span>
                </div>
                <div class="app-ledger-cell">
                    <span class="app-label">Avg win</span>
                    <span class="app-ledger-value app-gain">@(s.AvgWinPoints is { } w ? DashboardFormat.SignedPoints(w) : "—")</span>
                    <span class="app-ledger-sub">per winning trade</span>
                </div>
            </div>

            <div class="app-ledger-cell app-ledger-center">
                <span class="app-label">Win rate</span>
                <span class="app-ledger-value">@DashboardFormat.Percent(s.WinRate)</span>
                <span class="app-ledger-sub">@(s.Wins)W · @(s.Losses)L · @(s.Breakevens) BE not counted</span>
            </div>

            <div class="app-ledger-side right">
                <div class="app-ledger-cell">
                    <span class="app-label">Avg loss</span>
                    <span class="app-ledger-value app-loss">@(s.AvgLossPoints is { } l ? DashboardFormat.SignedPoints(l) : "—")</span>
                    <span class="app-ledger-sub">per losing trade</span>
                </div>
                <div class="app-ledger-cell">
                    <span class="app-label">Worst streak</span>
                    <span class="app-ledger-value app-loss">@(s.WorstLossStreak)L</span>
                    <span class="app-ledger-sub">
                        losses in a row · now
                        <span class="@(streak.Outcome == EOutcome.Win ? "app-gain" : streak.Outcome == EOutcome.Loss ? "app-loss" : "")">@StreakLabel(streak)</span>
                    </span>
                </div>
            </div>
        </section>

        <div class="app-dash-grid">
            <section class="app-card app-equity-card" data-fullscreen style="padding:20px 22px;" aria-label="Equity curve">
                <div style="display:flex; align-items:flex-start; justify-content:space-between; flex-wrap:wrap; gap:12px; margin-bottom:10px;">
                    <div>
                        <div style="font-size:15px; font-weight:700;">Equity curve</div>
                        <div class="app-balance app-mono @(_equityView.NetEuro < 0 ? "app-loss" : "")">@DashboardFormat.Euro(_equityView.EndBalance)</div>
                    </div>
                    <div style="display:flex; align-items:flex-start; gap:14px;">
                        <div style="text-align:right; font-size:12px; color:var(--app-text-secondary); line-height:1.7;">
                            <div>Start <span class="app-mono">@DashboardFormat.Euro(_equityView.StartBalance)</span> · Net <span class="app-mono @DashboardFormat.ToneClass(_equityView.NetEuro)">@DashboardFormat.SignedEuro(_equityView.NetEuro)</span> (<span class="app-mono">@ReturnLabel(_equityView.NetEuro, _equityView.StartBalance)</span>)</div>
                            <div>Max drawdown <span class="app-mono app-loss">@DashboardFormat.Euro(_equityView.MaxDrawdown)</span></div>
                        </div>
                        @* A plain onclick (not @onclick): full screen is handled in the browser (wwwroot/js/fullscreen.js), no server round trip. *@
                        <button type="button" class="app-fs-btn" onclick="appFullscreen.toggle(this)" title="Full screen (Esc to close)" aria-label="Toggle full screen">
                            <svg class="app-fs-enter" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" /></svg>
                            <svg class="app-fs-exit" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 4v5H4M15 4v5h5M9 20v-5H4M15 20v-5h5" /></svg>
                        </button>
                    </div>
                </div>
                @* Which part of the history the curve shows. Reset curves are never deleted: "All history" always
                   shows everything, with each reset marked. The date pickers are hidden in full screen (their
                   calendars open outside the full-screen element). *@
                <div class="app-equity-controls">
                    <div class="app-seg" role="group" aria-label="Equity curve history">
                        <button type="button" aria-pressed="@(_scope == EquityScope.SinceLastReset ? "true" : "false")" @onclick="() => SelectScope(EquityScope.SinceLastReset)"
                                title="@(_accountSettings.Resets.Count == 0 ? "No reset yet: the same as all history" : "From the last reset")">
                            @(_accountSettings.Resets.Count == 0 ? "Whole curve" : "Since last reset")
                        </button>
                        <button type="button" aria-pressed="@(_scope == EquityScope.AllHistory ? "true" : "false")" @onclick="() => SelectScope(EquityScope.AllHistory)"
                                title="Everything that went down, with each reset marked">
                            All history
                        </button>
                    </div>
                    @if (_accountSettings.Resets.Count > 0)
                    {
                        <span class="app-equity-note">@_accountSettings.Resets.Count reset@(_accountSettings.Resets.Count == 1 ? "" : "s") · last on @DashboardFormat.ShortDate(DateOnly.FromDateTime(_accountSettings.Resets[^1].ResetAtUtc))</span>
                    }
                    <div class="app-equity-range">
                        <div style="width:150px;">
                            <MudDatePicker Culture="AppCulture.DatePicker" @bind-Date="_equityFrom" @bind-Date:after="BuildEquity" Label="From" MaxDate="_equityTo" Clearable="true" Editable="true" Margin="Margin.Dense" Variant="Variant.Outlined" />
                        </div>
                        <div style="width:150px;">
                            <MudDatePicker Culture="AppCulture.DatePicker" @bind-Date="_equityTo" @bind-Date:after="BuildEquity" Label="To" MinDate="_equityFrom" Clearable="true" Editable="true" Margin="Margin.Dense" Variant="Variant.Outlined" />
                        </div>
                    </div>
                </div>
                <EquityChart Points="_equityView.Points" StartBalance="_equityView.StartBalance" />
                <div style="font-size:11.5px; color:var(--app-text-secondary); margin-top:8px;">
                    Each trade: points &times; volume = euro won or lost, add-ons included (each with its own volume).
                    @if (s.TradesWithoutResult > 0)
                    {
                        <span>@s.TradesWithoutResult trade(s) without points or volume recorded are left out of the money figures.</span>
                    }
                </div>
            </section>

            <section class="app-card" style="padding:20px 22px; display:flex; flex-direction:column; gap:20px;" aria-label="Performance breakdown">
                @* With a single strategy selected, a by-strategy breakdown would be one row repeating the figures above. *@
                @if (_strategy is null)
                {
                    <PerformanceBreakdown Title="By strategy" Rows="_byStrategy" />
                }
                <PerformanceBreakdown Title="By symbol" Rows="_bySymbol" />
            </section>
        </div>

        @* The filters only affect the grid, not the figures above it. *@
        <RecentTradesPanel Trades="_accountTrades" Title="Recent trades" ShowStrategyFilter="_strategy is null" />
    }

</div>
