@page "/"
@rendermode InteractiveServer
@using TradingTools.Blazor.Services.Dashboard

<MudProviders />

<PageTitle>Dashboard</PageTitle>

<TopBar Title="Dashboard" />

<div class="app-content">

    <div style="display:flex; align-items:flex-end; justify-content:space-between; flex-wrap:wrap; gap:12px;">
        <div>
            <MudText Typo="Typo.h5" Style="font-weight:800;">Dashboard</MudText>
            <MudText Typo="Typo.body2" Style="color:var(--app-text-secondary); margin-top:4px;">
                SRS &amp; Espresso &mdash; @DateTime.Now.ToString("dddd, MMMM d", System.Globalization.CultureInfo.InvariantCulture)
            </MudText>
        </div>
        @if (_accounts.Count > 0)
        {
            @* Wrapped: MudSelect renders a sibling element for its popover, which would otherwise take
               part in this row's space-between layout. *@
            <div style="width:220px;">
                <MudSelect T="SampleSizeType" Value="_account" ValueChanged="SelectAccount" Label="Account" Dense="true" Variant="Variant.Outlined">
                    @foreach (var account in _accounts)
                    {
                        <MudSelectItem Value="@account">@MyEnumConverter.TradeTypeFromEnum(account)</MudSelectItem>
                    }
                </MudSelect>
            </div>
        }
    </div>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Success" />
    }
    else if (_summary is null)
    {
        <div class="app-card" style="padding:48px; text-align:center;">
            <MudText Typo="Typo.h6">No trades yet</MudText>
            <MudText Typo="Typo.body2" Style="color:var(--app-text-secondary); margin-top:6px;">Closed SRS and Espresso trades will show up here.</MudText>
        </div>
    }
    else
    {
        <div class="app-kpi-grid">
            @foreach (var kpi in _kpis)
            {
                <div class="app-card" style="padding:20px;">
                    <div style="display:flex; align-items:center; justify-content:space-between;">
                        <div style="font-size:12.5px; font-weight:700; color:var(--app-text-secondary); letter-spacing:.02em;">@kpi.Label</div>
                        <div style="width:30px; height:30px; border-radius:8px; background:@(kpi.IsNegative ? "color-mix(in srgb, var(--app-error) 16%, transparent)" : "color-mix(in srgb, var(--app-accent) 16%, transparent)"); display:flex; align-items:center; justify-content:center;">
                            <MudIcon Icon="@kpi.Icon" Size="Size.Small" Style="@($"color:{(kpi.IsNegative ? "var(--app-error)" : "var(--app-accent)")}")" />
                        </div>
                    </div>
                    <div class="app-mono" style="font-size:24px; font-weight:600; margin-top:10px; color:@(kpi.IsNegative ? "var(--app-error)" : "var(--app-text-primary)");">@kpi.Value</div>
                    <div style="font-size:12px; color:var(--app-text-secondary); margin-top:6px;">@kpi.Sub</div>
                </div>
            }
        </div>

        <MudGrid Spacing="3">
            <MudItem xs="12" md="8">
                <div class="app-card" style="padding:22px 24px; height:100%;">
                    <div style="display:flex; align-items:flex-start; justify-content:space-between; flex-wrap:wrap; gap:12px; margin-bottom:6px;">
                        <div>
                            <MudText Typo="Typo.subtitle1" Style="font-weight:700;">Equity Curve</MudText>
                            <div class="app-mono" style="font-size:20px; font-weight:600; margin-top:2px; color:@(_summary.NetEuro < 0 ? "var(--app-error)" : "var(--app-accent)");">
                                @DashboardFormat.Euro(_summary.Balance)
                            </div>
                        </div>
                        <div style="text-align:right; font-size:12px; color:var(--app-text-secondary); line-height:1.6;">
                            <div>Start <span class="app-mono">@DashboardFormat.Euro(DashboardStats.StartingBalance)</span> · Net <span class="app-mono">@DashboardFormat.SignedEuro(_summary.NetEuro)</span></div>
                            <div>Max drawdown <span class="app-mono">@DashboardFormat.Euro(_maxDrawdown)</span></div>
                        </div>
                    </div>
                    <MudChart T="double" ChartType="ChartType.Line" ChartSeries="_equitySeries" ChartLabels="_equityLabels"
                              Width="100%" Height="280px" MatchBoundsToSize="true" ChartOptions="_chartOptions" />
                    <div style="font-size:11.5px; color:var(--app-text-secondary); margin-top:6px;">
                        Each trade: points &times; volume = euro won or lost.
                        @if (_summary.TradesWithoutResult > 0)
                        {
                            <span>@_summary.TradesWithoutResult trade(s) without points or volume recorded are left out of the money figures.</span>
                        }
                    </div>
                </div>
            </MudItem>
            <MudItem xs="12" md="4">
                <div style="display:flex; flex-direction:column; gap:20px; height:100%;">
                    <PerformanceBreakdown Title="Performance by Strategy" Rows="_byStrategy" />
                    <PerformanceBreakdown Title="Performance by Symbol" Rows="_bySymbol" />
                </div>
            </MudItem>
        </MudGrid>

        var filtered = FilteredTradesChronological;
        var filteredSummary = DashboardStats.Summarize(filtered);

        <div class="app-card" style="padding:8px 0 4px;">
            <div style="padding:14px 24px 6px;">
                <MudText Typo="Typo.subtitle1" Style="font-weight:700;">Recent Trades</MudText>
            </div>

            <div style="display:flex; flex-wrap:wrap; gap:12px; padding:6px 24px 10px; align-items:center;">
                <MudSelect T="string" Value="_filterStrategy" ValueChanged="OnStrategyFilterChanged" Label="Strategy" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="width:150px; flex:0 0 auto;">
                    <MudSelectItem Value="@All">All</MudSelectItem>
                    @foreach (var s in StrategyOptions)
                    {
                        <MudSelectItem Value="@s">@s</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="string" Value="_filterTimeFrame" ValueChanged="OnTimeFrameFilterChanged" Label="Time frame" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="width:140px; flex:0 0 auto;">
                    <MudSelectItem Value="@All">All</MudSelectItem>
                    @foreach (var tf in TimeFrameOptions)
                    {
                        <MudSelectItem Value="@tf">@MyEnumConverter.TimeFrameFromEnum(Enum.Parse<TimeFrame>(tf))</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="int" @bind-Value="_filterSampleSizeId" Label="Sample size" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="width:190px; flex:0 0 auto;">
                    <MudSelectItem Value="0">All</MudSelectItem>
                    @foreach (var option in SampleSizeOptions)
                    {
                        <MudSelectItem Value="@option.Id">@option.Label</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="PeriodFilter" @bind-Value="_filterPeriod" Label="Period" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="width:160px; flex:0 0 auto;">
                    @foreach (var period in Enum.GetValues<PeriodFilter>())
                    {
                        <MudSelectItem Value="@period">@PeriodLabel(period)</MudSelectItem>
                    }
                </MudSelect>
                @if (_filterPeriod == PeriodFilter.LastXTrades)
                {
                    <MudNumericField T="int" @bind-Value="_lastXTrades" Label="X" Min="1" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="width:100px; flex:0 0 auto;" Immediate="true" />
                }
            </div>

            <div style="padding:0 24px 8px; font-size:12px; color:var(--app-text-secondary);">
                @filtered.Count trades · @(filteredSummary.Wins)W / @(filteredSummary.Losses)L / @(filteredSummary.Breakevens) BE ·
                Win rate <span class="app-mono">@DashboardFormat.Percent(filteredSummary.WinRate)</span> ·
                Net <span class="app-mono" style="color:@(filteredSummary.NetEuro < 0 ? "var(--app-error)" : "var(--app-accent)");">@DashboardFormat.SignedEuro(filteredSummary.NetEuro)</span>
            </div>

            <MudTable T="DashboardTrade" Items="@(Enumerable.Reverse(filtered))" Dense="true" Hover="true" Elevation="0" RowsPerPage="10" Class="app-recent-trades">
                <HeaderContent>
                    <MudTh>Date</MudTh>
                    <MudTh>Symbol</MudTh>
                    <MudTh>Dir</MudTh>
                    <MudTh>Strategy</MudTh>
                    <MudTh>TF</MudTh>
                    <MudTh>Sample</MudTh>
                    <MudTh>Volume</MudTh>
                    <MudTh>Points</MudTh>
                    <MudTh>P&amp;L</MudTh>
                    <MudTh>Outcome</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Date" Style="color:var(--app-text-secondary); white-space:nowrap;">@DashboardFormat.ShortDate(context.Date)</MudTd>
                    <MudTd DataLabel="Symbol"><span class="app-mono" style="font-weight:700;">@context.Symbol</span></MudTd>
                    <MudTd DataLabel="Dir"><span class="app-chip @(context.Direction == EDirection.Long ? "app-chip-green" : "app-chip-red")">@context.Direction</span></MudTd>
                    <MudTd DataLabel="Strategy" Style="color:var(--app-text-secondary);">@MyEnumConverter.StrategyFromEnum(context.Strategy)</MudTd>
                    <MudTd DataLabel="TF" Style="color:var(--app-text-secondary);">@MyEnumConverter.TimeFrameFromEnum(context.TimeFrame)</MudTd>
                    <MudTd DataLabel="Sample" Style="color:var(--app-text-secondary);">#@context.SampleSizeNumber</MudTd>
                    <MudTd DataLabel="Volume"><span class="app-mono">@(context.Volume is { } v ? DashboardFormat.Number(v) : "—")</span></MudTd>
                    <MudTd DataLabel="Points"><span class="app-mono">@(context.Points is { } p ? DashboardFormat.SignedPoints(p) : "—")</span></MudTd>
                    <MudTd DataLabel="P&amp;L">
                        @if (context.Euro is { } euro)
                        {
                            <span class="app-mono" style="font-weight:600; color:@(euro < 0 ? "var(--app-error)" : euro > 0 ? "var(--app-accent)" : "var(--app-text-secondary)");">@DashboardFormat.SignedEuro(euro)</span>
                        }
                        else
                        {
                            <span class="app-mono" style="color:var(--app-text-secondary);">—</span>
                        }
                    </MudTd>
                    <MudTd DataLabel="Outcome"><span class="app-chip @OutcomeChip(context.Outcome)">@context.Outcome</span></MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Typo="Typo.body2" Style="color:var(--app-text-secondary); padding:16px;">No trades match these filters.</MudText>
                </NoRecordsContent>
                <PagerContent>
                    <MudTablePager PageSizeOptions="PageSizes" />
                </PagerContent>
            </MudTable>
        </div>
    }

</div>
