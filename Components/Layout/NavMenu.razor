@using TradingTools.Blazor.Services.Reviews
@using TradingTools.Blazor.Services.Validation
@inject ITradeValidationMonitor ValidationMonitor
@inject IServiceScopeFactory ScopeFactory

<header class="app-header">
    <a class="app-brand" href="">
        @* Gain and loss strokes mirrored across a centre axis. *@
        <svg class="app-brand-glyph" width="26" height="26" viewBox="0 0 26 26" aria-hidden="true">
            <rect x="12.25" y="2" width="1.5" height="22" rx=".75" fill="currentColor"></rect>
            <path d="M3 17 L7 11 L10 13.5" fill="none" stroke="var(--app-accent)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
            <path d="M23 9 L19 15 L16 12.5" fill="none" stroke="var(--app-error)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <span class="app-brand-name">Trading Tools</span>
    </a>

    <nav class="app-nav" aria-label="Main">
        <NavLink class="app-nav-item" href="" Match="NavLinkMatch.All">Dashboard</NavLink>
        <NavLink class="app-nav-item" href="trades">Trades</NavLink>
        <NavLink class="app-nav-item" href="history">History</NavLink>
        <span class="app-nav-sep" aria-hidden="true"></span>

        @* The header is part of the (static) layout, so the counts are as of the page load. *@
        <details class="app-nav-menu">
            <summary class="app-nav-item">
                Data check
                @if (_allSet)
                {
                    <span class="app-nav-dot ok" title="All set"></span>
                }
                else if (_needsAttention)
                {
                    <span class="app-nav-dot" title="Something needs attention"></span>
                }
            </summary>
            <div class="app-nav-menu-panel">
                @if (_allSet)
                {
                    <div class="app-nav-menu-allset">All set, Mr. Discipline.</div>
                }
                <NavLink class="app-nav-menu-item" href="validation">
                    Trade validation
                    @if (_invalidTrades > 0)
                    {
                        <span class="app-nav-badge" title="Trades with invalid data">@_invalidTrades</span>
                    }
                </NavLink>
                <NavLink class="app-nav-menu-item" href="reviews">
                    Reviews
                    @if (_reviewsDue > 0)
                    {
                        <span class="app-nav-badge" title="Reviews to do">@_reviewsDue</span>
                    }
                </NavLink>
            </div>
        </details>
        <NavLink class="app-nav-item" href="backup">Backup</NavLink>
        <NavLink class="app-nav-item" href="settings">Settings</NavLink>
    </nav>

    <div class="app-header-actions">
        @* A real link rather than a click handler: the layout is static, and a Blazor handler does
           nothing without an active circuit. *@
        <NavLink href="new-trade" class="app-btn-primary">New trade</NavLink>
        <details class="app-account-menu">
            <summary class="app-avatar" title="Account menu">EA</summary>
            <div class="app-account-menu-panel">
                <div class="app-account-menu-user">
                    <div class="app-account-menu-name">Emil</div>
                    <div class="app-account-menu-sub">Personal account</div>
                </div>
                <hr class="app-account-menu-divider" />
                <form method="post" action="/account/logout">
                    <button type="submit" class="app-account-menu-logout">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                        Logout
                    </button>
                </form>
            </div>
        </details>
    </div>
</header>

@code {
    private int _reviewsDue;
    private int _invalidTrades => ValidationMonitor.LatestReport?.InvalidTrades.Count ?? 0;
    // Only "all set" once the validation has actually run (right after the app starts there is no report yet).
    private bool _allSet => ValidationMonitor.LatestReport is not null && _invalidTrades == 0 && _reviewsDue == 0;
    private bool _needsAttention => _invalidTrades > 0 || _reviewsDue > 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Own scope, so its own DbContext: the menu renders in the same request as the page, at the same time,
            // and one DbContext can't run two queries at once.
            await using var scope = ScopeFactory.CreateAsyncScope();
            var reviews = scope.ServiceProvider.GetRequiredService<IReviewService>();
            _reviewsDue = (await reviews.GetDueAsync()).Sum(d => d.Reviews.Count);
        }
        catch
        {
            // A failed lookup must never take the whole page down: the menu just shows no count.
            _reviewsDue = 0;
        }
    }
}
