<div class="app-topbar">
    <div class="app-topbar-title">@Title</div>
    <div style="display:flex; align-items:center; gap:12px;">
        @ChildContent
        @if (ShowNewTradeButton)
        {
            @* A plain anchor rather than a @onclick handler + NavigateTo: TopBar is used on both
               interactive pages (Trades.razor) and static ones (Dashboard, Calculator, ...), and a
               Blazor click handler does nothing without an active circuit - a real link works either
               way, no interactivity required. *@
            <a href="new-trade" class="app-btn-primary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 8v8M8 12h8"></path></svg>
                New Trade
            </a>
        }
        <details class="app-account-menu">
            <summary class="app-avatar" title="Account menu">EA</summary>
            <div class="app-account-menu-panel">
                <div class="app-account-menu-user">
                    <div class="app-account-menu-name">Emil</div>
                    <div class="app-account-menu-sub">Personal account</div>
                </div>
                <hr class="app-account-menu-divider" />
                <form method="post" action="/account/logout">
                    <button type="submit" class="app-account-menu-logout">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                        Logout
                    </button>
                </form>
            </div>
        </details>
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public bool ShowNewTradeButton { get; set; } = true;
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
