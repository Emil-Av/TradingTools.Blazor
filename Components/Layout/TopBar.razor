@* The page heading: title in the display face, an optional line under it, and optional controls on
   the right. The app-wide nav, New trade button and account menu live in NavMenu.razor. *@
<div class="app-page-head">
    <div>
        <h1 class="app-page-title">@Title</h1>
        @if (!string.IsNullOrEmpty(Subtitle))
        {
            <div class="app-page-sub">@Subtitle</div>
        }
    </div>
    @if (ChildContent is not null)
    {
        <div class="app-page-actions">@ChildContent</div>
    }
</div>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
