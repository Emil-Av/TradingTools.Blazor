<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\TradingToolsRazor\DataAccess\DataAccess.csproj" />
    <ProjectReference Include="..\TradingToolsRazor\Models\Models.csproj" />
    <ProjectReference Include="..\TradingToolsRazor\Shared\Shared.csproj" />
    <ProjectReference Include="..\TradingToolsRazor\Statistics\Statistics.csproj" />
    <ProjectReference Include="..\TradingToolsRazor\Utilities\Utilities.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HtmlSanitizer" Version="9.2.1039" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="9.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="MudBlazor" Version="9.9.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.2" />
    <PackageReference Include="Radzen.Blazor" Version="11.4.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The test project lives in Tests/ inside this folder; keep its files out of the web project's default globs. -->
    <Compile Remove="Tests/**" />
    <Content Remove="Tests/**" />
    <None Remove="Tests/**" />
    <EmbeddedResource Remove="Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TradingTools.Blazor.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
